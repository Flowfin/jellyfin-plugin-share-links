<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.ShareLinks.Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- The packaging step publishes the solution, so without this the test
         assembly and its xunit and Moq dependencies are published into the same
         directory the plugin package is built from and ship to operators. -->
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <!-- Collects line coverage during the test run (#80). The collector rather
         than a global tool: it runs inside the same dotnet test invocation the
         gate already makes, so the number is measured on the run that judges the
         change and not on a second run of something else. -->
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- The plugin project excludes these at runtime because a running server
         supplies them. A test host is not a server, so the test project pulls the
         same versions in with their runtime assets. -->
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)" />
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jellyfin.Plugin.ShareLinks\Jellyfin.Plugin.ShareLinks.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\build.yaml" Link="build.yaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\README.md" Link="README.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\docs\threat-model.md" Link="threat-model.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\docs\configuration.md" Link="configuration.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\docs\playback-visibility.md" Link="playback-visibility.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\docs\personal-data.md" Link="personal-data.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\docs\bounds.md" Link="bounds.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\docs\guest-capabilities.md" Link="guest-capabilities.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\docs\api.md" Link="api.md" CopyToOutputDirectory="PreserveNewest" />
    <!-- The whole directory, because LimitsTests compares the documents docs/limits.md
         names against the documents that exist, and a list of individual copies here
         would be the second list the comparison is meant to remove. -->
    <None Include="..\docs\*.md" Link="docs\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
