# Build output and restored packages. Nothing here is written by hand, and the
# check would be reporting on whatever the last build left behind rather than on
# the tree.
node_modules/
**/bin/
**/obj/
artifacts/

# The lockfile is npm's to write. Reformatting it puts prettier and `npm ci` in
# disagreement over a file only one of them owns.
package-lock.json

# Same for NuGet. `dotnet restore` writes packages.lock.json and rewrites it in its
# own style on the next force-evaluate, so a prettier pass would be undone by the
# next person who adds a package and would show up as their diff.
**/packages.lock.json

# The fuzz seed corpus. These are bytes handed to a fuzzer, derived from the
# token encoding rather than written, and prettier has no business reading them.
Jellyfin.Plugin.ShareLinks.Fuzz/corpus/
