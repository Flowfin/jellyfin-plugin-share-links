<Project>
    <PropertyGroup>
        <!-- The graph is watched, not only recorded. NuGet checks the restored graph
             against the advisory database and NU1901 to NU1904 are raised to errors, so a
             known-vulnerable package fails the restore. Left as warnings they would be
             true and green, printed into a log nobody reads.
    
             This board committed a lockfile and ran no audit, which is the worse half of
             the pair: the graph was held still and nothing looked at it. Eleven boards of
             this fleet were in that state on 2026-08-18, and the twelfth is why it
             matters. jellyfin-plugin-watchlist was told by Scorecard about one high
             advisory; switching this on found a second one rated critical that Scorecard
             had never reported.
    
             Mode all rather than direct: both of those arrived under the Jellyfin
             packages and neither was referenced by a project file, so a direct-only audit
             would have found neither.
    
             Nothing is pinned here. Measured with the audit forced on from the command
             line, this board reports no advisory today; the entry is the detector, not a
             repair.
    
             Note for whoever edits this comment: an XML comment may not contain two
             hyphens in a row. A draft elsewhere in this fleet spelled out a command line
             flag, left the file malformed, and the build failed on a property defined
             twenty lines below. -->
        <NuGetAudit>true</NuGetAudit>
        <NuGetAuditMode>all</NuGetAuditMode>
        <NuGetAuditLevel>low</NuGetAuditLevel>
        <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
    </PropertyGroup>

    <PropertyGroup>
        <!-- A committed lockfile per project. Without one a restore is free to resolve a
             transitive package to whatever the feed offers that day, so two builds of the
             same commit can carry different code and neither says so. With one, that
             resolution is a file in the tree and a change to it is a diff somebody reads.

             Locked mode is not turned on here but passed as a flag on the routes that must
             not move the graph, because turning it on for every local build would refuse
             the ordinary act of adding a package before the lockfile has been written. The
             one CI route that deliberately moves the graph, the floor restore in ci.yaml,
             is left without it and says so at the call.

             publish.yaml has restored in locked mode since it was written and fails with
             an explicit error when the lockfile is absent, which it was: the release route
             would have failed on first use.

             Note for whoever edits this comment: an XML comment may not contain two
             hyphens in a row, so the flag is named in prose here rather than written out.
             A draft that spelled it caused MSBuild to lose the rest of this file, and the
             build failed with NU1015 on a version that was defined twenty lines below. -->
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    </PropertyGroup>

    <PropertyGroup>
        <!-- The version is read out of build.yaml rather than written here, so the
             number a catalogue shows and the number inside the DLL cannot be two
             numbers. The release gate proves the tag equals build.yaml's version and
             then proves the assembly carries the same value, and a second
             hand-maintained copy of that number is exactly what the second proof
             exists to catch.

             A REGEX OVER A YAML FILE IS THE MEANS, and it is chosen rather than
             inherited. The packaging tool builds the plugin itself and is handed no
             MSBuild properties, so the only number it can stamp into the shipped
             assembly is one the tree already holds; nothing but an evaluation-time
             read gets it there, and MSBuild has no YAML reader. The pattern is
             anchored to a line starting with the field name, and a build.yaml the
             pattern stops matching leaves the property empty rather than wrong -
             which PackagingMetadataTests refuses on every run.

             WHAT THIS GAVE UP is not a detail and is written down rather than left
             to be discovered. 0.0.0.0 was reserved so that an assembly reporting it
             was known not to have come from the release process. That reservation
             and a release that stamps its own version could not both exist, because
             the packager reads the tree. The reservation went; docs/versioning.md
             says so in place of the argument it used to carry.

             Keep these on one line each: the version scheme is read by tools that
             match the element, not the XML. -->
        <ManifestVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)build.yaml')), '(?m)^version:[ ]*"([0-9]+(\.[0-9]+)*)"').Groups.get_Item(1).Value)</ManifestVersion>
        <Version>$(ManifestVersion)</Version>
        <AssemblyVersion>$(ManifestVersion)</AssemblyVersion>
        <FileVersion>$(ManifestVersion)</FileVersion>
        <!-- The server line this plugin is built for. The plugin project compiles
             against it and excludes it at runtime, because the server supplies it;
             the test project needs the same assemblies present to run at all. One
             property so the two cannot drift apart. -->
        <!-- Two lines now, and the version is a function of the target framework
             rather than a second property somebody sets (#181). The 12.0 packages
             support net10.0 only, so the two lines cannot share a compiled assembly
             and the framework is already what tells them apart. Written this way, a
             build cannot ask for the 12.0 packages at net9.0 or the other way round,
             which is the drift a free standing version property invites.

             12.0 is a release candidate and this plugin does not claim to support it.
             The decision of 2026-08-21 on #181 is that the multi-targeting lands now
             and that packaging, the abi floor and the readme's supported line
             sentence wait for 12.0.0 to be released. build.yaml still names one
             targetAbi and one framework for that reason.

             THE 12.0 PIN STAYS WHERE IT LANDED. It moves only by a change that says
             why, until a 12.0.0 exists; on the day one appears it moves to 12.0.0
             and the abi floor leg reads it. Decided on #340 on 2026-09-04, against
             tracking the newest candidate: every candidate on this line stamps the
             same assembly version, so following them changes the surface the build
             compiles against without changing anything a manifest or a floor check
             can see. Seven candidates had been published when that was taken and
             this pin is the fifth, which is the state the rule is for rather than
             an oversight.

             The 10.11 pin is not the newest release of that line either. It is the
             floor build.yaml declares in targetAbi, because an assembly compiled
             against anything newer binds types the declared floor does not have
             (#136). docs/versioning.md carries both rules and ServerLinePinTests
             compares the two values below against it. -->
        <JellyfinVersion Condition="'$(TargetFramework)' == 'net9.0'">10.11.9</JellyfinVersion>
        <JellyfinVersion Condition="'$(TargetFramework)' == 'net10.0'">12.0.0-rc5</JellyfinVersion>
    </PropertyGroup>

    <PropertyGroup>
        <!-- Two builds of one commit have to produce one assembly, or a published
             artefact cannot be checked against the source it claims to come from.
             Deterministic alone is not enough: it leaves the absolute source path in
             the output, so the same commit built in two directories gave two hashes.
             ContinuousIntegrationBuild is what normalises those paths, and it is on
             everywhere rather than only in CI, because a property that holds in one
             place is not the property. The cost is that a local debugger no longer
             finds sources by absolute path and uses the source server instead. -->
        <Deterministic>true</Deterministic>
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
    </PropertyGroup>
</Project>
